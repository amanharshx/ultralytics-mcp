{
  "tool": "dataset_export",
  "args": {
    "dataset": "example-dataset-1"
  },
  "api": [
    {
      "method": "GET",
      "path": "/api/account/summary",
      "response": {
        "status": 200,
        "json": {
          "username": "example-owner",
          "name": "Example User",
          "accountType": "personal",
          "creditsCents": 1790,
          "plan": "free",
          "counts": {
            "projects": 32,
            "datasets": 27,
            "models": 14
          },
          "teams": []
        }
      }
    },
    {
      "method": "GET",
      "path": "/api/datasets/example-owner/example-dataset-1/export",
      "response": {
        "status": 200,
        "json": {
          "downloadUrl": "https://storage.googleapis.com/example-bucket/exports/example-id/example-dataset-1.ndjson",
          "cached": false
        }
      }
    }
  ],
  "expected": {
    "summary": "Export link for dataset 'example-dataset-1' for owner 'example-owner' (version latest, cached=false). This link is time-limited and will expire.",
    "data": {
      "downloadUrl": "https://storage.googleapis.com/example-bucket/exports/example-id/example-dataset-1.ndjson",
      "cached": false,
      "version": null
    }
  }
}
