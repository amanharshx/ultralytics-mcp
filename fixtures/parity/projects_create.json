{
  "tool": "projects_create",
  "args": {
    "name": "Example project",
    "project": "example-project-create"
  },
  "api": [
    {
      "method": "GET",
      "path": "/api/account/summary",
      "response": {
        "status": 200,
        "json": {
          "username": "example-owner",
          "name": "Example User",
          "accountType": "personal",
          "creditsCents": 1790,
          "plan": "free",
          "counts": {
            "projects": 8,
            "datasets": 22,
            "models": 14
          },
          "teams": []
        }
      }
    },
    {
      "method": "POST",
      "path": "/api/projects",
      "json": {
        "project": "example-project-create",
        "name": "Example project",
        "visibility": "private",
        "owner": "example-owner"
      },
      "response": {
        "status": 201,
        "json": {
          "id": "000000000000000000000008",
          "owner": "example-owner",
          "project": "example-project-create",
          "region": "eu"
        }
      }
    }
  ],
  "expected": {
    "summary": "Created project 'example-project-create' for owner 'example-owner' with id '000000000000000000000008' (private).",
    "data": {
      "id": "000000000000000000000008",
      "owner": "example-owner",
      "project": "example-project-create",
      "region": "eu"
    }
  }
}
