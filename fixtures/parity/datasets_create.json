{
  "tool": "datasets_create",
  "args": {
    "name": "Example dataset",
    "dataset": "example-dataset-create",
    "task": "detect"
  },
  "api": [
    {
      "method": "GET",
      "path": "/api/account/summary",
      "response": {
        "status": 200,
        "json": {
          "username": "example-owner",
          "name": "Example User",
          "accountType": "personal",
