          "plan": "free",
          "counts": {
            "projects": 32,
            "datasets": 27,
            "models": 14
          },
          "teams": []
        }
      }
    },
    {
      "method": "POST",
      "path": "/api/datasets",
      "json": {
        "dataset": "example-dataset-create",
        "name": "Example dataset",
        "task": "detect",
        "visibility": "private",
        "owner": "example-owner"
      },
      "response": {
        "status": 201,
        "json": {
          "id": "000000000000000000000008",
          "owner": "example-owner",
          "dataset": "example-dataset-create",
          "region": "eu"
        }
      }
    }
  ],
  "expected": {
    "summary": "Created dataset 'example-dataset-create' for owner 'example-owner' with id '000000000000000000000008' (private).",
    "data": {
      "id": "000000000000000000000008",
      "owner": "example-owner",
      "dataset": "example-dataset-create",
      "region": "eu"
    }
  }
}
